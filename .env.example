# Required for server-managed AI calls. Never commit a real value.
OPENAI_API_KEY=

# Optional overrides; the defaults preserve the current production models.
OPENAI_RESPONSE_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=1

# Optional origins for non-credentialed public API reads only.
# Study sessions require the same-origin frontend served by FastAPI.
CORS_ORIGINS=

# Optional storage location. The default is backend/users.
OT_DATA_DIR=

# Production default true: HTTPS-only host-bound session cookies.
# Set false ONLY for local HTTP development; never on a public deployment.
OT_SESSION_COOKIE_SECURE=true

# Upload and ingestion safety limits (bytes unless noted).
MAX_UPLOAD_BYTES=26214400
MAX_ZIP_MEMBERS=50
MAX_PDF_BYTES=12582912
MAX_TOTAL_UNCOMPRESSED_BYTES=52428800
MAX_USER_STORAGE_BYTES=104857600
MAX_DOCUMENTS_PER_SESSION=50
MAX_PDF_PAGES=300
MAX_PDF_TEXT_CHARS=2000000
MAX_INGEST_CHUNKS=2500
MAX_INDEXED_CHUNKS_PER_SESSION=10000

LOG_LEVEL=INFO

# Persistent fixed-window request budgets, shared across local workers.
MAX_NEW_SESSIONS_PER_HOUR=100
MAX_AI_REQUESTS_PER_SESSION_HOUR=60
MAX_AI_REQUESTS_PER_DAY=500
MAX_UPLOADS_PER_SESSION_HOUR=20
MAX_UPLOADS_PER_HOUR=200

# Cross-worker local-filesystem AI concurrency leases. Active leases renew;
# this duration is the crash/accounting-outage recovery window.
MAX_CONCURRENT_AI_REQUESTS_PER_SESSION=1
MAX_CONCURRENT_AI_REQUESTS=4
AI_CONCURRENCY_LEASE_SECONDS=3600
