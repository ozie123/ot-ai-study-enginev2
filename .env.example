# Required for server-managed AI calls. Never commit a real value.
OPENAI_API_KEY=

# Optional overrides; the defaults preserve the current production models.
OPENAI_RESPONSE_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=1

# Optional comma-separated origins for a separately hosted frontend.
# Leave empty for the same-origin frontend served by FastAPI.
CORS_ORIGINS=

# Optional storage location. The default is backend/users.
OT_DATA_DIR=

# Upload and ingestion safety limits (bytes unless noted).
MAX_UPLOAD_BYTES=26214400
MAX_ZIP_MEMBERS=50
MAX_PDF_BYTES=12582912
MAX_TOTAL_UNCOMPRESSED_BYTES=52428800
MAX_USER_STORAGE_BYTES=104857600
MAX_PDF_PAGES=300
MAX_PDF_TEXT_CHARS=2000000
MAX_INGEST_CHUNKS=2500

LOG_LEVEL=INFO
